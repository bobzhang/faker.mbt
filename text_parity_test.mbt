///|
test "upstream parity seed 0" {
  let f = @faker.Faker(seed=0)
  f.seed(0)
  json_inspect(f.word_adjective(), content="negligible")
  f.seed(0)
  json_inspect(f.word_noun(min_length=5, max_length=5), content="pants")
  f.seed(0)
  json_inspect(
    f.word_verb(min_length=100, max_length=100, strategy=Closest),
    content="internationalize",
  )
  f.seed(0)
  json_inspect(f.word_sample(), content="jealous")
  f.seed(0)
  json_inspect(f.word_words(), content="tapioca blaring")
  f.seed(0)
  json_inspect(f.lorem_word(), content="inflammatio")
  f.seed(0)
  json_inspect(f.lorem_words(), content="inflammatio sumo pax")
  f.seed(0)
  json_inspect(
    f.lorem_sentence(),
    content="Sumo pax impedit curriculum sint debitis vallum.",
  )
  f.seed(0)
  json_inspect(
    f.lorem_paragraph(),
    content="Sumo pax impedit curriculum sint debitis vallum. Credo textilis eveniet minus vespillo aeneus alias accusator tristis tergo. Volutabrum thermae deinde termes angustus rerum arbitro vinco enim.",
  )
  f.seed(0)
  json_inspect(
    f.lorem_paragraphs(),
    content="Sumo pax impedit curriculum sint debitis vallum. Credo textilis eveniet minus vespillo aeneus alias accusator tristis tergo. Volutabrum thermae deinde termes angustus rerum arbitro vinco enim.\nCelo teres defleo minus accusamus quae. Provident villa statim contigo debilito subiungo adulescens. Spargo bene aperiam comedo convoco molestiae decens voveo.\nBellicus arx solitudo. Deleniti caries articulus amor sollicito. Auxilium corporis trado alter.",
  )
  f.seed(0)
  json_inspect(
    f.lorem_lines(),
    content="Pax impedit curriculum sint debitis vallum vix credo.\nEveniet minus vespillo aeneus alias accusator tristis tergo usus.\nThermae deinde termes angustus rerum arbitro vinco enim cuppedia celo.",
  )
  f.seed(0)
  json_inspect(
    f.lorem_text(),
    content="Pax impedit curriculum sint debitis vallum vix credo. Eveniet minus vespillo aeneus alias accusator tristis tergo usus. Thermae deinde termes angustus rerum arbitro vinco enim cuppedia celo.",
  )
}

